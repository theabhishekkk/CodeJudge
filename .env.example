APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codejudge
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codejudge
REDIS_URL=redis://localhost:6379/0
BROKER_URL=amqp://guest:guest@localhost:5672//
JWT_SECRET=change-me-in-production-use-a-long-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
BATCH_MAX_ITEMS=500
BATCH_RATE_PER_HOUR=20
MAX_ACTIVE_SUBMISSIONS_PER_USER=1000
BATCH_REQUEST_MAX_BYTES=20971520
BATCH_STALE_PENDING_SECONDS=120
WORKER_CONCURRENCY=4
MAX_PARALLEL_CONTAINERS=8
WORKER_HOST_ID=codejudge-worker
WORKER_POOL=threads
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SANDBOX_WORKDIR=/tmp/codejudge
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
VITE_BATCH_MAX_ITEMS=500
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploy
