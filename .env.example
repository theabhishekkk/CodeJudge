APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codejudge
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codejudge
REDIS_URL=redis://localhost:6379/0
BROKER_URL=amqp://guest:guest@localhost:5672//
JWT_SECRET=change-me-in-production-use-a-long-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
SANDBOX_WORKDIR=/tmp/codejudge
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploy
